# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# 430차: 폰트 빌드 산출물(scripts/build-detail-fonts.mjs, 바이너리는 저장소에 넣지 않는다)
/public/fonts

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# claude code local config/state
/.claude/

# playwright login session (contains auth cookies/tokens)
scripts/auth-state.json

# ad-hoc QA screenshots and test fixture photos (not needed in history)
review/*.png
review/iteration/
scripts/test-assets/
test-assets/
public/iteration-fixtures/

# local TEST_MODE image-analysis cache (Claude vision)
.cache/

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local temp state
supabase/.temp/

# review capture logs/debug output (review/*.png?? ???? ????)
review/*.log
review/**/*.json
review/*.txt

# auto loop control files
loop/STOP
loop/STOPPED.txt
loop/DONE.txt
